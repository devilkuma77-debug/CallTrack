{
  "name": "CallTech",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "node scripts/install-android-apk.js install && node scripts/grant-android-permissions.js",
    "android:install": "node scripts/install-android-apk.js install",
    "android:push-apk": "node scripts/install-android-apk.js push",
    "android:open-apk": "node scripts/install-android-apk.js open",
    "android:launch": "node scripts/install-android-apk.js launch",
    "android:grant": "node scripts/grant-android-permissions.js",
    "android:hide": "node scripts/hide-launcher-icon.js",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start --port 8081",
    "start:reset": "react-native start --port 8081 --reset-cache",
    "server": "npm --prefix server start",
    "server:install": "npm --prefix server install",
    "server:test": "npm --prefix server run test:db",
    "server:test:data-api": "npm --prefix server run test:data-api",
    "server:watch": "npm --prefix server run watch",
    "server:lan": "node scripts/setup-lan-sync.js",
    "android:sync": "node scripts/trigger-phone-sync.js",
    "android:permissions": "node scripts/request-android-permissions.js",
    "test": "jest",
    "postinstall": "node scripts/patch-rn-android-cli.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native/new-app-screen": "0.86.2",
    "@react-navigation/bottom-tabs": "^7.18.16",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-call-log": "^3.0.0",
    "react-native-safe-area-context": "^5.8.1",
    "react-native-screens": "^4.27.0",
    "react-native-vector-icons": "^10.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
