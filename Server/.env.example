# Copy to server/.env and fill values

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=calltech
PORT=3000

# Phone kill-state sync (HTTPS) — Render deploy URL:
# SYNC_API_URL=https://your-app.onrender.com/api
#
# Same WiFi test (PC par npm run server chalao):
# SYNC_API_URL=http://192.168.1.5:3000/api

# Option: Atlas Data API (mobile data par bina server)
# ATLAS_DATA_APP_ID=
# ATLAS_DATA_API_KEY=
# ATLAS_DATA_SOURCE=Cluster0
# ATLAS_DATA_REGION=
